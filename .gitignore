# Whitelist: everything is ignored, only the files listed below are tracked.
# New files must be added here explicitly. This keeps build output, logs, dumps and the
# generated SDK out of the repository.

/*

!/.gitignore
!/.gitattributes
!/LICENSE.txt
!/NOTICE.md
!/README.md
!/HOW_TO_PLAY.md
!/THIRD_PARTY_LICENSES.md
!/ProjectMonolith.sln
!/fetch_sdk.bat
!/build.bat
!/server_launcher.bat
!/client_launcher.bat
!/deckbuilder.bat
!/server_launcher.sh
!/client_launcher.sh

!/tools/
/tools/*
!/tools/fetch_sdk.ps1
!/tools/build.ps1
!/tools/ORIGIN.md

!/Server/
/Server/*
!/Server/ORIGIN.md
!/Server/dllmain.cpp
!/Server/dllmain.h
!/Server/framework.h
!/Server/pch.cpp
!/Server/pch.h
!/Server/jsoncpp.cpp
!/Server/json/
!/Server/Server.vcxproj
!/Server/Server.vcxproj.filters
!/Server/MinHook/
/Server/MinHook/lib/*
!/Server/MinHook/lib/libMinHook-x64-v141-mt.lib

!/Client/
/Client/*
!/Client/ORIGIN.md
!/Client/dllmain.cpp
!/Client/framework.h
!/Client/pch.cpp
!/Client/pch.h
!/Client/jsoncpp.cpp
!/Client/json/
!/Client/Client.vcxproj
!/Client/Client.vcxproj.filters
!/Client/MinHook/
/Client/MinHook/lib/*
!/Client/MinHook/lib/libMinHook-x64-v141-mt.lib

!/Injector/
/Injector/*
!/Injector/ORIGIN.md
!/Injector/dllmain.cpp
!/Injector/Exports.def
!/Injector/framework.h
!/Injector/pch.cpp
!/Injector/pch.h
!/Injector/Injector.vcxproj
!/Injector/Injector.vcxproj.filters

# Safety net inside whitelisted folders
*.dll
*.pdb
*.obj
*.pch
*.ilk
*.exp
*.user
*.log
*.txt
!/LICENSE.txt
!/ai_documentation_EN.txt
